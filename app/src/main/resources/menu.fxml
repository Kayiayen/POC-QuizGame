<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="quiz.UIController">

    <VBox alignment="CENTER" spacing="20">
        <Label fx:id="title" text="QuizGame" />
        <Button fx:id="playButton" onAction="#menuPressed" styleClass="menu-button" text="Play" />
        <Button fx:id="settingsButton" onAction="#menuPressed" styleClass="menu-button" text="Settings" />
        <Button fx:id="helpButton" onAction="#menuPressed" styleClass="menu-button" text="Help" />
        <Button fx:id="exitButton" onAction="#menuPressed" styleClass="menu-button" text="Exit" />
    </VBox>
   <VBox fx:id="settingsOverlay" alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="50.0" style="-fx-background-color: rgba(0,0,0,0.85);" visible="false">
      <children>
           <Label style="-fx-font-size: 24px; -fx-text-fill: white;" text="Settings" />
           <HBox alignment="CENTER" spacing="100.0">
               <VBox alignment="CENTER" spacing="5">
                   <Label style="-fx-text-fill: white;" text="Music" />
                   <Slider fx:id="musicSlider" />
               </VBox>
               <VBox alignment="CENTER" spacing="5">
                   <Label style="-fx-text-fill: white;" text="SFX" />
                   <Slider fx:id="sfxSlider" />
               </VBox>
           </HBox>
           <Button fx:id="settingsClose" onAction="#menuPressed" text="Close" />
      </children>
   </VBox>
   <StackPane fx:id="helpOverlay" style="-fx-background-color: rgba(0,0,0,0.85);" visible="false">
      <children>
         <VBox alignment="CENTER" maxWidth="300.0" spacing="20.0">
            <children>
               <Label style="-fx-text-fill: white;" text="Help" />
               <TextArea editable="false" prefHeight="300.0" text="Insert Help Here...&#10;Pls" />
               <Button mnemonicParsing="false" onMouseClicked="#helpClose" text="Close" />
            </children>
         </VBox>
      </children>
   </StackPane>
</StackPane>
