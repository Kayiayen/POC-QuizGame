<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="quiz.UIController"
      spacing="20"
      alignment="CENTER">

    <Label fx:id="title" 
      text="Select Difficulty" />

    <Button fx:id="easy" 
      text="Easy" 
    styleClass="difficulty-button" 
    onAction="#handleDifficulty" />
    
    <Button fx:id="intermediate" 
      text="Intermediate" 
    styleClass="difficulty-button" 
    onAction="#handleDifficulty" />
    
    <Button fx:id="hard" 
      text="Hard" 
    styleClass="difficulty-button" 
    onAction="#handleDifficulty" />

</VBox>