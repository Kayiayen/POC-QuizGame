<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="quiz.UIController">
   <children>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="100.0">
         <children>
            <VBox alignment="CENTER" spacing="20">
               <children>
                  <Label fx:id="title" text="Select Difficulty" />
                  <JFXButton fx:id="easyToggle" buttonType="RAISED" onAction="#difficultySelected" styleClass="difficulty-button" text="Easy" />
                  <JFXButton fx:id="intermediateToggle" buttonType="RAISED" onAction="#difficultySelected" styleClass="difficulty-button" text="Intermediate" />
                  <JFXButton fx:id="hardToggle" buttonType="RAISED" onAction="#difficultySelected" styleClass="difficulty-button" text="Hard" />
               </children>
            </VBox>
            <VBox alignment="CENTER" prefHeight="200.0" prefWidth="200.0" spacing="20.0">
               <children>
                  <Label text="Description" />
                  <TextArea fx:id="descArea" editable="false" prefHeight="200.0" prefWidth="133.0" wrapText="true" />
                  <HBox alignment="CENTER" spacing="50.0">
                     <children>
                        <JFXButton fx:id="backButton" buttonType="RAISED" onAction="#backMenu" styleClass="menu-button" text="Back" />
                        <JFXButton fx:id="startButton" buttonType="RAISED" onAction="#difficultyStart" styleClass="menu-button" text="Start" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</StackPane>