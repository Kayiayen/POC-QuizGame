<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="quiz.UIController">
   <children>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="100.0">
         <children>
            <VBox alignment="CENTER" spacing="20">
               <children>
                  <Label fx:id="title" text="Select Difficulty" />
                  <ToggleButton fx:id="easyToggle" mnemonicParsing="false" styleClass="difficulty-button" text="Easy">
                     <toggleGroup>
                        <ToggleGroup fx:id="difficultyGroup" />
                     </toggleGroup></ToggleButton>
                  <ToggleButton fx:id="intermediateToggle" layoutX="17.0" layoutY="150.0" mnemonicParsing="false" styleClass="difficulty-button" text="Intermediate" toggleGroup="$difficultyGroup" />
                  <ToggleButton fx:id="hardToggle" layoutX="17.0" layoutY="304.0" mnemonicParsing="false" styleClass="difficulty-button" text="Hard" toggleGroup="$difficultyGroup" />
               </children>
            </VBox>
            <VBox alignment="CENTER" prefHeight="200.0" prefWidth="200.0" spacing="20.0">
               <children>
                  <Label text="Description" />
                  <TextArea fx:id="descArea" editable="false" prefHeight="200.0" prefWidth="133.0" wrapText="true" />
                  <Button fx:id="startButton" onAction="#difficultyStart" styleClass="menu-button" text="Start" />
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</StackPane>
