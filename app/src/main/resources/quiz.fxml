<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="quiz.QuizController">
   <children>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
         <children>
            <Label fx:id="questionText" alignment="CENTER" contentDisplay="CENTER" styleClass="question-text" textAlignment="CENTER" wrapText="true" />
            <HBox alignment="CENTER" spacing="20.0">
               <children>
                  <VBox alignment="CENTER_LEFT" maxHeight="300.0" maxWidth="300.0" spacing="20.0">
                     <children>
                        <Button fx:id="answer1" onAction="#submitAnswer" styleClass="answer-button" text="A" wrapText="true" />
                        <Button fx:id="answer2" onAction="#submitAnswer" styleClass="answer-button" text="B" wrapText="true" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER_LEFT" maxHeight="300.0" maxWidth="300.0" spacing="20">
                     <children>
                        <Button fx:id="answer3" onAction="#submitAnswer" styleClass="answer-button" text="C" wrapText="true" />
                        <Button fx:id="answer4" onAction="#submitAnswer" styleClass="answer-button" text="D" wrapText="true" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
      <VBox fx:id="optionsOverlay" alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="50.0" style="-fx-background-color: rgba(0,0,0,0.85);" visible="false">
         <children>
            <Label style="-fx-font-size: 24px; -fx-text-fill: white;" text="Options" />
            <HBox alignment="CENTER" spacing="50">
               <children>
                  <VBox alignment="CENTER" spacing="5">
                     <children>
                        <Label style="-fx-text-fill: white;" text="Music" />
                        <Slider fx:id="musicSlider" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" spacing="5">
                     <children>
                        <Label style="-fx-text-fill: white;" text="SFX" />
                        <Slider fx:id="sfxSlider" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <HBox alignment="CENTER" spacing="20.0">
               <children>
                  <Button mnemonicParsing="false" onMouseClicked="#backDifficulty" text="Back" />
                  <Button fx:id="settingsClose" onMouseClicked="#closePressed" text="Resume" />
                  <Button layoutX="240.0" layoutY="10.0" mnemonicParsing="false" onMouseClicked="#helpShow" text="Help" />
               </children>
            </HBox>
         </children>
      </VBox>
      <StackPane fx:id="helpOverlay" prefHeight="150.0" prefWidth="300.0" style="-fx-background-color: rgba(0,0,0,0.85);" visible="false">
         <children>
            <VBox alignment="CENTER" maxWidth="300.0" spacing="20.0">
               <children>
                  <Label style="-fx-text-fill: white;" text="Help" />
                  <TextArea editable="false" prefHeight="300.0" text="Insert Help Here...&#10;Pls" />
                  <Button mnemonicParsing="false" onMouseClicked="#helpClose" text="Close" />
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</StackPane>
