<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="quiz.QuizController">
   <children>

      <!-- ============ Main quiz view ============ -->
      <VBox alignment="CENTER" spacing="20.0">
         <children>
            <!-- Status bar: score (left) + timer (right) -->
            <HBox alignment="CENTER_LEFT" maxWidth="640.0" spacing="10.0">
               <children>
                  <Label fx:id="scoreLabel" styleClass="status-label" text="Score: 0 / 0" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="timerLabel" styleClass="status-label" text="Time: 30" />
               </children>
            </HBox>

            <Label fx:id="questionText" alignment="CENTER" contentDisplay="CENTER" styleClass="question-text" textAlignment="CENTER" wrapText="true" />

            <HBox alignment="CENTER" spacing="20.0">
               <children>
                  <VBox alignment="CENTER_LEFT" maxHeight="300.0" maxWidth="300.0" spacing="20.0">
                     <children>
                        <JFXButton fx:id="answer1" buttonType="RAISED" maxWidth="Infinity" onAction="#submitAnswer" styleClass="answer-button" wrapText="true" />
                        <JFXButton fx:id="answer2" buttonType="RAISED" maxWidth="Infinity" onAction="#submitAnswer" styleClass="answer-button" wrapText="true" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER_LEFT" maxHeight="300.0" maxWidth="300.0" spacing="20">
                     <children>
                        <JFXButton fx:id="answer3" buttonType="RAISED" maxWidth="Infinity" onAction="#submitAnswer" styleClass="answer-button" wrapText="true" />
                        <JFXButton fx:id="answer4" buttonType="RAISED" maxWidth="Infinity" onAction="#submitAnswer" styleClass="answer-button" wrapText="true" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>

      <!-- ============ Options overlay (ESC / Resume) ============ -->
      <VBox fx:id="optionsOverlay" alignment="CENTER" spacing="50.0" styleClass="overlay-bg" visible="false">
         <children>
            <Label styleClass="overlay-title" text="Options" />
            <HBox alignment="CENTER" spacing="20.0">
               <children>
                  <JFXButton buttonType="RAISED" onAction="#backDifficulty" styleClass="overlay-button" text="Back" />
                  <JFXButton fx:id="settingsClose" buttonType="RAISED" onAction="#closePressed" styleClass="overlay-button" text="Resume" />
                  <JFXButton buttonType="RAISED" onAction="#helpShow" styleClass="overlay-button" text="Help" />
               </children>
            </HBox>
         </children>
      </VBox>

      <!-- ============ Help overlay ============ -->
      <StackPane fx:id="helpOverlay" styleClass="overlay-bg" visible="false">
         <children>
            <VBox alignment="CENTER" maxWidth="500.0" spacing="20.0">
               <children>
                  <Label styleClass="overlay-text" text="Help" />
                  <TextArea editable="false" prefHeight="300.0" text="Game Rules:&#10;&#10;1. Choose difficulty — pick Easy, Medium, or Hard before starting.&#10;2. Answer each question — choose the correct option for every question.&#10;3. Beat the timer — answer before the timer runs out.&#10;4. Earn points — one point per correct answer.&#10;5. Finish the quiz — complete all questions and check your final score.&#10;&#10;Navigation:&#10;&#10;Press ESCAPE to show the game options." />
                  <JFXButton buttonType="RAISED" onAction="#helpClose" styleClass="overlay-button" text="Close" />
               </children>
            </VBox>
         </children>
      </StackPane>

      <!-- ============ Results overlay (end of quiz) ============ -->
      <StackPane fx:id="resultsOverlay" styleClass="overlay-bg" visible="false">
         <children>
            <VBox alignment="CENTER" maxWidth="400.0" spacing="30.0">
               <children>
                  <Label styleClass="overlay-title" text="Quiz Complete" />
                  <Label fx:id="resultsLabel" styleClass="results-text" textAlignment="CENTER" wrapText="true" />
                  <HBox alignment="CENTER" spacing="20.0">
                     <children>
                        <JFXButton buttonType="RAISED" onAction="#playAgain" styleClass="overlay-button" text="Play Again" />
                        <JFXButton buttonType="RAISED" onAction="#resultsToMenu" styleClass="overlay-button" text="Main Menu" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </StackPane>

   </children>
</StackPane>
